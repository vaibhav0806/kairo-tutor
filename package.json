{
  "name": "kairo-tutor",
  "version": "0.1.0",
  "description": "A screen-native AI tutor for practical software labs on macOS.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaibhav0806/kairo-tutor.git"
  },
  "homepage": "https://meetkairo.xyz",
  "bugs": {
    "url": "https://github.com/vaibhav0806/kairo-tutor/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "app:build:unsigned": "tauri build --bundles app --no-sign",
    "app": "bash scripts/rebuild-run.sh",
    "app:local": "KAIRO_BACKEND_TARGET=local bash scripts/rebuild-run.sh",
    "app:hosted": "KAIRO_BACKEND_TARGET=hosted bash scripts/rebuild-run.sh",
    "local": "bash scripts/dev-local.sh",
    "dist": "bash scripts/build-dmg.sh",
    "release": "bash scripts/release.sh",
    "updater:keygen": "bash scripts/updater-keygen.sh",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:providers": "node scripts/smoke-providers.mjs",
    "server:dev": "npm run dev -w @kairo/server",
    "server:build": "npm run build -w @kairo/server",
    "server:start": "npm run start -w @kairo/server",
    "server:test": "npm run test -w @kairo/server",
    "db:generate": "npm run db:generate -w @kairo/server",
    "db:migrate": "npm run db:migrate -w @kairo/server",
    "invite": "npm run invite -w @kairo/server --",
    "invite:prod": "bash server/scripts/invite-prod.sh",
    "billing:test:prepare": "npm run db:migrate && node server/scripts/verify-billing-test-env.mjs",
    "billing:test:login": "node server/scripts/dodo-test-login.mjs",
    "billing:test:listen": "npm run billing:test:prepare && npx --yes dodopayments-cli@3.4.0 wh listen http://localhost:8787/webhooks/dodo"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@uiw/react-color-shade-slider": "^2.10.3",
    "@uiw/react-color-wheel": "^2.10.3",
    "@vitejs/plugin-react": "^4.3.4",
    "framer-motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.7",
    "vite": "^6.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
