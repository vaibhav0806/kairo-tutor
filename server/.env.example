# Kairo server development env (this file is committed with placeholders, never real secrets).
# Copy to server/.env and fill. server/.env is gitignored.
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787

# Contributor default: stock PostgreSQL on a literal loopback address.
KAIRO_DATABASE_TARGET=local-postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/kairo_local
# Kairo maintainers may use the guarded Neon dev branch instead:
# KAIRO_DATABASE_TARGET=neon
# DATABASE_URL=<pooled Neon dev connection string>

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth (redirect URI: http://localhost:8787/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Require the desktop OAuth correlation state. Enforced by default; set to false only if a build
# predating the correlated sign-in ever needs to authenticate.
KAIRO_REQUIRE_DESKTOP_AUTH_STATE=true

# Log the truncated upstream provider error body. Off by default (bodies can echo request
# content); turn on temporarily to diagnose a provider failure. Lengths are always logged.
KAIRO_LOG_PROVIDER_BODIES=false

# Host directory holding the release DMGs, mounted read-only into the container by
# docker-compose and served by the email-gated download route. Compose REFUSES to build
# without it, so a deploy host that never sets it fails at `docker compose build` — set it
# in the box's server/.env rather than relying on an exported shell variable.
KAIRO_RELEASE_DIR=/absolute/path/to/kairo-releases

# AI provider keys (proxied server-side; never reach the desktop bundle)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

# Speech engine policy. The desktop never picks a vendor — it asks for /v1/stt and
# /v1/tts/stream and the server resolves the engine, so changing these is a restart, not
# a new DMG for every installed user. A provider whose key is missing is dropped from the
# allowlist automatically, so it never appears in the app's Settings picker.
KAIRO_STT_PROVIDER=sarvam
KAIRO_TTS_PROVIDER=sarvam
KAIRO_TTS_PROVIDERS_ENABLED=sarvam,elevenlabs

# Dodo Payments — DODO_ENV selects which key/secret pair is used (test in dev, live on prod).
# Same var names as the repo-root .env, so keys live in one place with no confusion.
DODO_ENV=test_mode
DODO_KAIRO_TEST_KEY=
DODO_KAIRO_LIVE_KEY=
DODO_TEST_WEBHOOK_SECRET=
DODO_LIVE_WEBHOOK_SECRET=
# The single Pro product id — both held; DODO_ENV picks. Billing 503s until the active one is set.
DODO_KAIRO_TEST_PRODUCT_ID=
DODO_KAIRO_LIVE_PRODUCT_ID=
